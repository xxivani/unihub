{
    # Email address for Let's Encrypt (use a generic alias if you prefer)
    email no-reply@unihub.bham.team
    # Use the real ACME endpoint for obtaining certificates
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

unihub.bham.team {
    tls internal
    handle_errors {
        respond "This production version of the app will only become available after a tagged commit has been made to the main branch.

A development version of the app should be accessible here: http://unihub.dev.bham.team

Error connecting to production app backend on docker host http://team77-prd:8080.

After a tagged commit has deployed, wait 30 seconds and refresh this page.

If still not live, login to the VM via SSH and try to debug using 'docker compose -f ~/team-project/prd.yml up'"
    }
    reverse_proxy http://team77-prd:8080
}

unihub.dev.bham.team {
    handle_errors {
        respond "Error connecting to unihub.dev development app backend on docker host http://team77-dev:8080.

After a commit to the main branch has deployed, wait 30 seconds and refresh this page.

If still not live, login to the VM via SSH and try to debug using 'docker compose -f ~/team-project/dev.yml up'"
    }
    reverse_proxy http://team77-dev:8080
}

# The following block is optional and acts as a fallback when accessing via the VM IP.
DEPLOY_IP:80 {
    header Content-Type text/html
    respond <<HTML
          <html>
           <h1>Caddy web server is running on DEPLOY_IP </h1> <br/>
           <p>After getting DNS entries from <a href="https://forms.office.com/e/C0kaiRMuDD">https://forms.office.com/e/C0kaiRMuDD</a> <br/> try:
           <a href="http://unihub.dev.bham.team">http://unihub.dev.bham.team</a> or<br> <a href="http://unihub.bham.team">http://unihub.bham.team</a> </p>
          <html>
          HTML 200
}

