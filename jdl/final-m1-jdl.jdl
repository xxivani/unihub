enum Theme {
	LIGHT,
    DARK
}

enum Language {
	ENGLISH,
    CHINESE
}

enum Role {
	STUDENT,
    COMMITTEE,
    ADMIN
}

enum ApprovalStatus {
	UNDER_APPROVAL,
	UNAPPROVED,
    APPROVED,
    BOOKED,
    COMPLETED
}

enum EventCategory {
	ACADEMIC
    SOCIAL
    OFF_CAMPUS
    OTHER
}

enum EventFilters {
	FESTIVE,
    SPORTS,
    INFORMATIVE,
    FREE,
    RECURRING,
    COMPUTER_SCIENCE,
    BUSINESS,
    PSYCHOLOGY
    ECONOMICS,
    FINANCE
}

enum ExternalEventFilters {
	HACKATHON,
    WORKSHOP,
    NETWORKING,
    CAREER,
    SPORTS,
    GUEST_LECTURE,
    SOCIAL_GATHERING,
    VOLUNTEERING
}

enum ClubCategory {
	ACADEMIC,
    SOCIAL,
    SPORTS
}

enum Permission {
	NONE,
    CreateEvent,
    ListRoleOpening,
    UpdateLink,
    HostVoting,
    AssignPosition,
    UpdateBudget,
    TextChatroom
}

//to colour-code notifications, for notification preferences
enum Categories {
	CLUB,
    EVENT,
    ROLE_OPENING,
    NEWS,
    OTHER
}

enum CommitteeRoles {
	PRESIDENT,
    VICE_PRESIDENT,
    TREASURER
    STUDENT_ENGAGEMENT_OFFICER,
    SOCIAL_MEDIA_MANAGER,
    OPERATIONS_HEAD
    EVENTS_OFFICER
}

enum NewsCategory {
	ANNOUNCEMENT,
    CLUB_UPDATE
    NEWSLETTER
}

//NOTE: Entities may overlap, comments is just for bifurcation purposes
//Homepage, Navigation & Settings: Shivani
entity User {
	userId Integer required,
    userName String required,
    userEmail String required,
    userYearOfStudy Integer required,
    userRole Role required
}

entity UserNotificationPreference {
	user User required,
    category Categories
}

//many-to-many relationship
entity UserNotifications {
	user User required,
    notification Notifications required
    read Boolean
}

//Notifications: General
entity Notifications {
	title String required,
    shortDesc String required,
    longDesc String required,
    createdAt Instant required,
    category Categories required
}

//Clubs & Societies: Takwa
entity Club {
	clubId Integer required
    clubName String required,
    description String required,
    createdBy User required, 
    createdAt Instant required,
    imageUrl String,
    clubCategory ClubCategory required,
    recurringEvents Boolean required,
}

//Budget Tracker: Manasa
entity BudgetTracker {
	budgetTrackerId Integer required,
    totalBudget Double required,
    remainingBudget Double required
}

entity ClubExpenses {
	event Event required,
    predictedExpense Double required,
    actualExpense Double required,
    reimburse Boolean,
    cateringExpense Double,
    venueExpense Double, 
    materialExpense Double, 
    transportExpense Double,
    prizeExpense Double
}

//Calendar: Haozhe
entity CommitteeCalendar {
    event Event required,
    approvalStatus ApprovalStatus required
    busyDay Boolean
}

entity StudentCalendar {
    event Event required,
  	eventCategory EventCategory required
    busyDay Boolean
}

//Events and Event-registration: Ying Hao
entity Event {
	eventId Integer required,
    eventName String required,
    eventDate Instant required,
    eventLocation String required,
    imageUrl String,
    club Club required,
    createdBy CommitteeMember required,
    createdDate Instant required,
    eventCategory EventCategory required,
    paymentRequired Boolean required,
    maxNumberOfAttendees Integer,
	status ApprovalStatus required
}

entity EventFilter {
    eventId Long required,
    filterType EventFilters required
}

entity ExternalEvent {
	externalEventId Integer required,
    eventName String required,
    eventDate Instant required,
    eventLocation String required,
    locationLink String required,
    imageUrl String,
    club Club required,
    createdBy CommitteeMember required,
    createdDate Instant required,
    paymentRequired Boolean required,
    maxNumberOfAttendees Integer,
	status ApprovalStatus required
}

entity ExternalEventFilter {
	externalEventId Integer required,
    filterType ExternalEventFilters required
}

entity EventRegistration {
    event Event required,
    user User required,
    applicationDate Instant required,
    paymentStatus Boolean
}

//Role Opening, Voting & Committee Page: Saachi
entity RoleOpening {
    roleOpeningId Integer required,
    title String required,
    description String required,
    createdBy CommitteeMember required,
    createdDate Instant required,
    dueDate Instant required,
    numberOfRegistrations Integer required,
    status Boolean required
}

entity RoleOpeningRegistration {
	roleOpening RoleOpening required,
    user User required,
    applicantCV AnyBlob,
    applicantSuitability TextBlob required,
    applicationDate Instant required
}

entity CommitteeMember {
	committeeMember User required,
    committeeMemberRole CommitteeRoles required,
    assignedDate Instant required,
}

entity CommitteePermissions {
	committeeMember CommitteeMember required,
    permission Permission required
}

entity Voting {
	votingId Integer required,
    topic String required,
    createdBy String required,
    createdDate Instant required
}

entity VotingOption {
	optionId Integer required,
    optionText String required
}

entity Votes {
	voting Voting required,
	commiteeMember CommiteeMember required,
    choice VotingOption required
}

//News: Shivani
entity News {
	newsId Integer required,
    title String required,
    content TextBlob required,
    createdAt Instant required,
    imageUrl String,
    category NewsCategory required
    author String required
}

//many-to-many relationship
entity ClubFollowers {
    club Club required,
    user User required
}

relationship ManyToMany {
    CommitteeMember{permissions} to Permission{committeeMembers},
    User{notifications} to UserNotifications{user},
    Notifications{users} to UserNotifications{notification},
    User{userNotificationPreferences} to UserNotificationPreference{user},
    Event{filters} to EventFilter{event},
    ExternalEvent{filters} to ExternalEventFilter{externalEvent}
}

relationship OneToOne {
    EventRegistration{paymentStatus} to PaymentStatus{eventRegistration},
    Event{eventCalendar} to EventCalendar{event}
    EventRegistration{clubExpenses} to ClubExpenses{eventRegistration}
}

relationship OneToMany {
	Event {offcampusEvent} to ExternalEvent{event},
	Club{committee} to CommitteeMember{club},
    CommitteeMember{permissions} to CommitteePermissions{committeeMember},
	Club{budgetTracker} to BudgetTracker{club},
	BudgetTracker{clubExpenses} to ClubExpenses{budgetTracker},
    Club{events} to Event{club},
    Event{signups} to EventRegistration{event},
    Club{roleOpening} to RoleOpening{club},
    Club{voting} to Voting{club},
    RoleOpening{registrations} to RoleOpeningRegistration{roleOpening},
    StudentCalendar{events} to Event{studentCalendar},
    CommitteeCalendar{events} to Event {committeeCalendar},
    Voting{options} to VotingOption{voting},
    Club{followers} to ClubFollowers{club},
    User{followedClubs} to ClubFollowers{user},
    User{signedEvents} to EventRegistration{user},
    User{signedRoleOpenings} to RoleOpeningRegistration{user}
}

relationship ManyToOne {
    Votes{voting} to Voting,
    Votes{committeeMember} to CommitteeMember,
    Votes{choice} to VotingOption
}

paginate CommitteeMember, RoleOpening, Event, Voting with pagination